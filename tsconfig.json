{
  // Type checking only (docs/ARCHITECTURE.md section 0). `noEmit` is the point: nothing here compiles or
  // bundles, so `src/` stays plain ES modules a browser loads straight from a static server. TypeScript is a
  // linter for the JSDoc we already write. `include` widens a directory at a time as each one is clean.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "src/engine/**/*.js",
    "src/net/**/*.js"
  ]
}

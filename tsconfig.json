{
  // Type checking only (docs/ARCHITECTURE.md section 0). `noEmit` is the point: nothing here compiles or
  // bundles, so `src/` stays plain ES modules a browser loads straight from a static server. TypeScript is a
  // linter for the JSDoc we already write. `include` widens a directory at a time as each one is clean.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    // Import specifiers name the real .ts file, not a .js that does not exist. Legal only under
    // noEmit, which is exactly what this config is: tsc checks, esbuild emits (tools/server.js
    // transforms per request for the dev loop, tools/build.js bundles for shipping), and Node 22
    // strips types natively for everything under tools/. See game-engine docs/TS_MIGRATION.md.
    "allowImportingTsExtensions": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.ts"
  ]
}
